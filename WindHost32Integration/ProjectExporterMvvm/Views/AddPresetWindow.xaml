<Window
    x:Class="ProjectExporterMvvm.Views.AddPresetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Server Preset"
    Width="400"
    Height="250"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,20"
            FontSize="16"
            FontWeight="Bold"
            Text="📋 Add Server Preset" />

        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,5"
            Text="Server URL:" />
        <TextBox
            x:Name="PresetUrlTextBox"
            Grid.Row="2"
            Margin="0,0,0,10"
            Padding="8"
            FontSize="14" />

        <TextBlock
            Grid.Row="3"
            VerticalAlignment="Top"
            FontStyle="Italic"
            Foreground="Gray"
            Text="Examples:&#x0a;• https://api.mycompany.com/api&#x0a;• http://192.168.1.100:5000/api&#x0a;• https://localhost:7001/api"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="4"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="5"
                Padding="15,8"
                Click="AddButton_Click"
                Content="✅ Add"
                IsDefault="True" />
            <Button
                Margin="5"
                Padding="15,8"
                Click="CancelButton_Click"
                Content="❌ Cancel"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>