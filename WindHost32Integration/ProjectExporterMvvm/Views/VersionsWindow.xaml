<Window
    x:Class="ProjectExporterMvvm.Views.VersionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Project Versions"
    Width="800"
    Height="500"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,20"
            Padding="15"
            Background="#E3F2FD"
            CornerRadius="4">
            <StackPanel>
                <TextBlock
                    x:Name="ProjectNameText"
                    FontSize="18"
                    FontWeight="Bold" />
                <TextBlock
                    x:Name="ProjectInfoText"
                    FontSize="12"
                    Foreground="Gray" />
            </StackPanel>
        </Border>

        <!--  Versions List  -->
        <DataGrid
            x:Name="VersionsDataGrid"
            Grid.Row="1"
            AlternatingRowBackground="#F9F9F9"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            GridLinesVisibility="Horizontal"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Version}"
                    Header="Version" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Metadata.Description}"
                    Header="Description" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding FormattedSize}"
                    Header="Size" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding FileCount}"
                    Header="Files" />
                <DataGridTextColumn
                    Width="130"
                    Binding="{Binding CreatedDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                    Header="Created" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Metadata.CreatedBy}"
                    Header="Created By" />
                <DataGridTemplateColumn Width="150" Header="Actions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="2"
                                    Padding="5,2"
                                    Background="#4CAF50"
                                    BorderThickness="0"
                                    Click="RunVersionButton_Click"
                                    Content="🚀 Run"
                                    Foreground="White"
                                    Tag="{Binding}" />
                                <Button
                                    Margin="2"
                                    Padding="5,2"
                                    Background="#F44336"
                                    BorderThickness="0"
                                    Click="DeleteVersionButton_Click"
                                    Content="🗑️"
                                    Foreground="White"
                                    Tag="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--  Buttons  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="5"
                Padding="15,8"
                Click="RefreshButton_Click"
                Content="🔄 Refresh" />
            <Button
                Margin="5"
                Padding="15,8"
                Click="CloseButton_Click"
                Content="✅ Close"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>