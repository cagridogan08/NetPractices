<Window
    x:Class="MainApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Data Processing App"
    Width="800"
    Height="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Control Panel  -->
        <GroupBox
            Grid.Row="0"
            Margin="0,0,0,10"
            Header="Background Process Control">
            <StackPanel Margin="10" Orientation="Horizontal">
                <Button
                    Name="StartProcessBtn"
                    Width="150"
                    Margin="0,0,10,0"
                    Click="StartProcess_Click"
                    Content="Start Background Process" />
                <Button
                    Name="StopProcessBtn"
                    Width="150"
                    Margin="0,0,10,0"
                    Click="StopProcess_Click"
                    Content="Stop Background Process" />
                <TextBlock
                    Name="ProcessStatusText"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="Not Started" />
            </StackPanel>
        </GroupBox>

        <!--  Operations Panel  -->
        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,10"
            Header="Data Operations">
            <StackPanel Margin="10">
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                    <Button
                        Name="ImportDataBtn"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="ImportData_Click"
                        Content="Import Data" />
                    <Button
                        Name="ExportDataBtn"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="ExportData_Click"
                        Content="Export Data" />
                    <Button
                        Name="ProcessLargeBtn"
                        Width="150"
                        Margin="0,0,10,0"
                        Click="ProcessLarge_Click"
                        Content="Process Large Dataset" />
                    <Button
                        Name="SendFileBtn"
                        Width="100"
                        Click="SendFileData_Click"
                        Content="Send File Data" />
                </StackPanel>

                <!--  Progress Bar  -->
                <ProgressBar
                    Name="ProgressBar"
                    Height="20"
                    Margin="0,10,0,0"
                    Visibility="Collapsed" />
                <TextBlock
                    Name="StatusText"
                    Margin="0,5,0,0"
                    Text="Ready" />
            </StackPanel>
        </GroupBox>

        <!--  Results Display  -->
        <GroupBox Grid.Row="2" Header="Results">
            <ScrollViewer>
                <TextBox
                    Name="ResultsTextBox"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </ScrollViewer>
        </GroupBox>

        <!--  Status Bar  -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Name="StatusBarText" Text="Ready" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>