<Window
    x:Class="Messaging.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Messaging.Wpf"
    Title="Complete Real-time Messaging App - All Protocols"
    Width="900"
    Height="700">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanInverterConverter x:Key="BooleanInverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Transport Configuration Panel  -->
        <GroupBox
            Grid.Row="0"
            Margin="5"
            Header="🚀 Transport Configuration">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Transport Type Selection  -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Content="Protocol:" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        ItemsSource="{Binding TransportTypes}"
                        SelectedValue="{Binding SelectedTransportType}" />

                    <Label
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Content="Client Name:" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding ClientName}" />

                    <!--  Named Pipe Configuration  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="5"
                        Orientation="Horizontal"
                        Visibility="{Binding IsNamedPipeSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="📦 " />
                        <Label VerticalAlignment="Center" Content="Pipe Name:" />
                        <TextBox
                            Width="200"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding PipeName}" />
                        <Label VerticalAlignment="Center" Content="Server Name:" />
                        <TextBox
                            Width="100"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding ServerName}" />
                    </StackPanel>

                    <!--  TCP Configuration  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="5"
                        Orientation="Horizontal"
                        Visibility="{Binding IsTcpSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="🌐 " />
                        <Label VerticalAlignment="Center" Content="Host:" />
                        <TextBox
                            Width="150"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding TcpHost}" />
                        <Label VerticalAlignment="Center" Content="Port:" />
                        <TextBox
                            Width="80"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding TcpPort}" />
                    </StackPanel>

                    <!--  UDP Configuration  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="5"
                        Orientation="Horizontal"
                        Visibility="{Binding IsUdpSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="📡 " />
                        <Label VerticalAlignment="Center" Content="Host:" />
                        <TextBox
                            Width="150"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding UdpHost}" />
                        <Label VerticalAlignment="Center" Content="Port:" />
                        <TextBox
                            Width="80"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding UdpPort}" />
                        <Label VerticalAlignment="Center" Content="Local Port:" />
                        <TextBox
                            Width="80"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding UdpLocalPort}" />
                    </StackPanel>

                    <!--  WebSocket Configuration  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="5"
                        Orientation="Horizontal"
                        Visibility="{Binding IsWebSocketSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="🔌 " />
                        <Label VerticalAlignment="Center" Content="Host:" />
                        <TextBox
                            Width="150"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding WebSocketHost}" />
                        <Label VerticalAlignment="Center" Content="Port:" />
                        <TextBox
                            Width="80"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding WebSocketPort}" />
                        <Label VerticalAlignment="Center" Content="Path:" />
                        <TextBox
                            Width="100"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding WebSocketPath}" />
                        <CheckBox
                            Margin="5"
                            VerticalAlignment="Center"
                            Content="Use SSL"
                            IsChecked="{Binding WebSocketUseSSL}"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}" />
                    </StackPanel>

                    <!--  InMemory Configuration  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="5"
                        Orientation="Horizontal"
                        Visibility="{Binding IsInMemorySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="💾 " />
                        <Label VerticalAlignment="Center" Content="Server Name:" />
                        <TextBox
                            Width="200"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding InMemoryServerName}" />
                    </StackPanel>

                    <!--  SignalR Configuration  -->
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="5"
                        Orientation="Horizontal"
                        Visibility="{Binding IsSignalRSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="⚡ " />
                        <Label VerticalAlignment="Center" Content="Host:" />
                        <TextBox
                            Width="120"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding SignalRHost}" />
                        <Label VerticalAlignment="Center" Content="Port:" />
                        <TextBox
                            Width="60"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding SignalRPort}" />
                        <Label VerticalAlignment="Center" Content="Hub Path:" />
                        <TextBox
                            Width="120"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding SignalRHubPath}" />
                        <CheckBox
                            Margin="5"
                            VerticalAlignment="Center"
                            Content="HTTPS"
                            IsChecked="{Binding SignalRUseHttps}"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}" />
                        <CheckBox
                            Margin="5"
                            VerticalAlignment="Center"
                            Content="Auto-Reconnect"
                            IsChecked="{Binding SignalREnableAutoReconnect}"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}" />
                    </StackPanel>

                    <!--  Simple gRPC Configuration  -->
                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="5"
                        Orientation="Horizontal"
                        Visibility="{Binding IsGrpcSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="🔧 " />
                        <Label VerticalAlignment="Center" Content="Host:" />
                        <TextBox
                            Width="150"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding GrpcHost}" />
                        <Label VerticalAlignment="Center" Content="Port:" />
                        <TextBox
                            Width="80"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding GrpcPort}" />
                        <CheckBox
                            Margin="5"
                            VerticalAlignment="Center"
                            Content="HTTPS"
                            IsChecked="{Binding GrpcUseHttps}"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}" />
                        <Label VerticalAlignment="Center" Content="Polling (ms):" />
                        <TextBox
                            Width="80"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding GrpcPollingInterval}" />
                    </StackPanel>

                    <!--  RTP Configuration  -->
                    <StackPanel
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="5"
                        Orientation="Horizontal"
                        Visibility="{Binding IsRtpSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="🚀 " />
                        <Label VerticalAlignment="Center" Content="Host:" />
                        <TextBox
                            Width="120"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding RtpHost}" />
                        <Label VerticalAlignment="Center" Content="Port:" />
                        <TextBox
                            Width="60"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding RtpPort}" />
                        <Label VerticalAlignment="Center" Content="Local Port:" />
                        <TextBox
                            Width="60"
                            Margin="5"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                            Text="{Binding RtpLocalPort}" />
                        <CheckBox
                            Margin="5"
                            VerticalAlignment="Center"
                            Content="Multicast"
                            IsChecked="{Binding RtpEnableMulticast}"
                            IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}" />
                        <Label VerticalAlignment="Center" Content="MC Address:" />
                        <TextBox
                            Width="100"
                            Margin="5"
                            IsEnabled="{Binding RtpEnableMulticast}"
                            Text="{Binding RtpMulticastAddress}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </GroupBox>

        <!--  Connection Control Panel  -->
        <GroupBox
            Grid.Row="1"
            Margin="5"
            Header="🎮 Connection Control">
            <StackPanel Margin="5" Orientation="Horizontal">
                <Button
                    Margin="5"
                    Padding="15,8"
                    Background="LightBlue"
                    BorderBrush="DodgerBlue"
                    Command="{Binding ConnectCommand}"
                    Content="📱 Connect as Client" />
                <Button
                    Margin="5"
                    Padding="15,8"
                    Background="LightGreen"
                    BorderBrush="Green"
                    Command="{Binding StartServerCommand}"
                    Content="🖥️ Start Server" />
                <Button
                    Margin="5"
                    Padding="15,8"
                    Background="LightCoral"
                    BorderBrush="Red"
                    Command="{Binding DisconnectCommand}"
                    Content="🔌 Disconnect/Stop" />
                <Button
                    Margin="5"
                    Padding="15,8"
                    Background="LightYellow"
                    BorderBrush="Orange"
                    Command="{Binding ClearMessagesCommand}"
                    Content="🗑️ Clear Messages" />
                <Border
                    Margin="15,5"
                    Padding="10,5"
                    Background="LightGray"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="{Binding StatusText}" />
                </Border>
            </StackPanel>
        </GroupBox>

        <!--  Messages and Connections Panel  -->
        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!--  Messages  -->
            <GroupBox
                Grid.Column="0"
                Margin="0,0,5,0"
                Header="💬 Messages">
                <ListView ItemsSource="{Binding Messages}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2"
                                Padding="8"
                                BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Error">
                                                <Setter Property="Background" Value="#FFCDD2" />
                                                <Setter Property="BorderBrush" Value="#F44336" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Handshake">
                                                <Setter Property="Background" Value="#E8F5E8" />
                                                <Setter Property="BorderBrush" Value="#4CAF50" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Sender}" Value="System">
                                                <Setter Property="Background" Value="#FFF3E0" />
                                                <Setter Property="BorderBrush" Value="#FF9800" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="Bold" Text="{Binding Sender}" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            FontSize="10"
                                            Foreground="Gray"
                                            Text="{Binding Type, StringFormat='[{0}]'}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,2"
                                        Text="{Binding Content}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="9"
                                        Foreground="Gray"
                                        Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>

            <!--  Connections  -->
            <GroupBox Grid.Column="1" Header="🔗 Active Connections">
                <ListView ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnectionInfo}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2"
                                Padding="6"
                                Background="AliceBlue"
                                BorderBrush="SteelBlue"
                                BorderThickness="1"
                                CornerRadius="3">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                    <TextBlock
                                        FontSize="9"
                                        Foreground="Gray"
                                        Text="{Binding Id, StringFormat='ID: {0}'}" />
                                    <TextBlock
                                        FontSize="9"
                                        Foreground="DarkBlue"
                                        Text="{Binding Address}" />
                                    <TextBlock
                                        FontSize="8"
                                        Foreground="Green"
                                        Text="{Binding ConnectedAt, StringFormat='Connected: {0:HH:mm:ss}'}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>
        </Grid>

        <!--  Message Input Panel  -->
        <GroupBox
            Grid.Row="3"
            Margin="5"
            Header="✉️ Send Message">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="MessageTextBox"
                    Grid.Column="0"
                    MaxHeight="80"
                    Margin="5"
                    Padding="8"
                    AcceptsReturn="True"
                    FontSize="14"
                    IsEnabled="{Binding IsConnected}"
                    KeyDown="MessageTextBox_KeyDown"
                    Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                <Button
                    Grid.Column="1"
                    Margin="5"
                    Padding="20,8"
                    Background="LightBlue"
                    BorderBrush="DodgerBlue"
                    Command="{Binding SendMessageCommand}"
                    Content="📤 Send"
                    FontWeight="Bold" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>