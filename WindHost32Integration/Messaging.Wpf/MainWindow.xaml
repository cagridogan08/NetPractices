<Window
    x:Class="Messaging.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Messaging.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Connection Panel  -->
        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,10"
            Padding="10"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="Name:" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    MinWidth="100"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Text="{Binding ClientName}" />

                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="5,0"
                    Padding="10,5"
                    Command="{Binding StartServerCommand}"
                    Content="Start Server" />
                <Button
                    Grid.Row="0"
                    Grid.Column="3"
                    Margin="5,0"
                    Padding="10,5"
                    Command="{Binding ConnectCommand}"
                    Content="Connect" />
                <Button
                    Grid.Row="0"
                    Grid.Column="4"
                    Margin="5,0"
                    Padding="10,5"
                    Command="{Binding DisconnectCommand}"
                    Content="Disconnect" />
                <Button
                    Grid.Row="0"
                    Grid.Column="5"
                    Margin="5,0"
                    Padding="10,5"
                    Command="{Binding ClearMessagesCommand}"
                    Content="Clear" />

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="Pipe Name:" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="5"
                    Margin="5,5,5,0"
                    VerticalAlignment="Center"
                    Text="{Binding PipeName}" />
            </Grid>
        </Border>

        <!--  Messages Panel  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,5,10"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="5"
                    Background="LightBlue">
                    <TextBlock FontWeight="Bold" Text="{Binding StatusText}" />
                </Border>

                <ScrollViewer
                    Grid.Row="1"
                    Padding="5"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,2"
                                    Padding="5"
                                    BorderBrush="LightGray"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Error">
                                                    <Setter Property="Background" Value="LightCoral" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="System">
                                                    <Setter Property="Background" Value="LightYellow" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel
                                            Grid.Row="0"
                                            Margin="0,0,0,3"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,5,0"
                                                FontWeight="Bold"
                                                Text="{Binding Sender}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="Gray"
                                                Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding Content}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  Connections Panel  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,10"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="5"
                    Background="LightGreen">
                    <TextBlock FontWeight="Bold" Text="Connected Clients" />
                </Border>

                <ScrollViewer
                    Grid.Row="1"
                    Padding="5"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Connections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,2"
                                    Padding="5"
                                    Background="LightCyan"
                                    BorderBrush="LightGray"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            FontWeight="Bold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            FontSize="10"
                                            Foreground="Gray"
                                            Text="{Binding ConnectedAt, StringFormat='{}{0:HH:mm:ss}'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  Message Input  -->
        <Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="5"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    MaxHeight="100"
                    AcceptsReturn="True"
                    KeyDown="MessageTextBox_KeyDown"
                    Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                    VerticalScrollBarVisibility="Auto" />
                <Button
                    Grid.Column="1"
                    MinWidth="60"
                    Margin="5,0,0,0"
                    Padding="15,5"
                    Command="{Binding SendMessageCommand}"
                    Content="Send" />
            </Grid>
        </Border>
    </Grid>
</Window>
