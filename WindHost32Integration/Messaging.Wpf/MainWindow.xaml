<Window
    x:Class="Messaging.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Messaging.Wpf"
    Title="Multi-Transport Messaging App"
    Width="800"
    Height="600">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanInverterConverter x:Key="BooleanInverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Transport Configuration Panel  -->
        <GroupBox
            Grid.Row="0"
            Margin="5"
            Header="Transport Configuration">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Transport Type Selection  -->
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="Transport Type:" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5"
                    IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                    ItemsSource="{Binding TransportTypes}"
                    SelectedValue="{Binding SelectedTransportType}" />

                <Label
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="Client Name:" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="3"
                    Margin="5"
                    IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                    Text="{Binding ClientName}" />

                <!--  Named Pipe Configuration  -->
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="5"
                    Orientation="Horizontal"
                    Visibility="{Binding IsNamedPipeSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Label VerticalAlignment="Center" Content="Pipe Name:" />
                    <TextBox
                        Width="200"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding PipeName}" />
                    <Label VerticalAlignment="Center" Content="Server Name:" />
                    <TextBox
                        Width="100"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding ServerName}" />
                </StackPanel>

                <!--  TCP Configuration  -->
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="5"
                    Orientation="Horizontal"
                    Visibility="{Binding IsTcpSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Label VerticalAlignment="Center" Content="Host:" />
                    <TextBox
                        Width="150"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding TcpHost}" />
                    <Label VerticalAlignment="Center" Content="Port:" />
                    <TextBox
                        Width="80"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding TcpPort}" />
                </StackPanel>

                <!--  UDP Configuration  -->
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="5"
                    Orientation="Horizontal"
                    Visibility="{Binding IsUdpSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Label VerticalAlignment="Center" Content="Host:" />
                    <TextBox
                        Width="150"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding UdpHost}" />
                    <Label VerticalAlignment="Center" Content="Port:" />
                    <TextBox
                        Width="80"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding UdpPort}" />
                    <Label VerticalAlignment="Center" Content="Local Port:" />
                    <TextBox
                        Width="80"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding UdpLocalPort}" />
                </StackPanel>

                <!--  WebSocket Configuration  -->
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="5"
                    Orientation="Horizontal"
                    Visibility="{Binding IsWebSocketSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Label VerticalAlignment="Center" Content="Host:" />
                    <TextBox
                        Width="150"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding WebSocketHost}" />
                    <Label VerticalAlignment="Center" Content="Port:" />
                    <TextBox
                        Width="80"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding WebSocketPort}" />
                    <Label VerticalAlignment="Center" Content="Path:" />
                    <TextBox
                        Width="100"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding WebSocketPath}" />
                    <CheckBox
                        Margin="5"
                        VerticalAlignment="Center"
                        Content="Use SSL"
                        IsChecked="{Binding WebSocketUseSSL}"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}" />
                </StackPanel>

                <!--  InMemory Configuration  -->
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="5"
                    Orientation="Horizontal"
                    Visibility="{Binding IsInMemorySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Label VerticalAlignment="Center" Content="Server Name:" />
                    <TextBox
                        Width="200"
                        Margin="5"
                        IsEnabled="{Binding Path=IsConnected, Converter={StaticResource BooleanInverter}}"
                        Text="{Binding InMemoryServerName}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!--  Connection Control Panel  -->
        <GroupBox
            Grid.Row="1"
            Margin="5"
            Header="Connection Control">
            <StackPanel Margin="5" Orientation="Horizontal">
                <Button
                    Margin="5"
                    Padding="10,5"
                    Command="{Binding ConnectCommand}"
                    Content="Connect as Client" />
                <Button
                    Margin="5"
                    Padding="10,5"
                    Command="{Binding StartServerCommand}"
                    Content="Start Server" />
                <Button
                    Margin="5"
                    Padding="10,5"
                    Command="{Binding DisconnectCommand}"
                    Content="Disconnect/Stop" />
                <Button
                    Margin="5"
                    Padding="10,5"
                    Command="{Binding ClearMessagesCommand}"
                    Content="Clear Messages" />
                <TextBlock
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="{Binding StatusText}" />
            </StackPanel>
        </GroupBox>

        <!--  Messages and Connections Panel  -->
        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <!--  Messages  -->
            <GroupBox
                Grid.Column="0"
                Margin="0,0,5,0"
                Header="Messages">
                <ListView ItemsSource="{Binding Messages}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2"
                                Padding="5"
                                BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Error">
                                                <Setter Property="Background" Value="LightCoral" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="System">
                                                <Setter Property="Background" Value="LightYellow" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{Binding Sender}" />
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>

            <!--  Connections  -->
            <GroupBox Grid.Column="1" Header="Connections">
                <ListView ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnectionInfo}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="Gray"
                                    Text="{Binding Address}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>
        </Grid>

        <!--  Message Input Panel  -->
        <GroupBox
            Grid.Row="3"
            Margin="5"
            Header="Send Message">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="MessageTextBox"
                    Grid.Column="0"
                    Margin="5"
                    IsEnabled="{Binding IsConnected}"
                    KeyDown="MessageTextBox_KeyDown"
                    Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    Margin="5"
                    Padding="15,5"
                    Command="{Binding SendMessageCommand}"
                    Content="Send" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>