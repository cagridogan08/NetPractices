<Window
    x:Class="LiveChartsTests.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveChartsTests"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scottplot="http://schemas.scottplot.net/2008/xaml/presentation"
    xmlns:testingGeared="clr-namespace:Geared.Wpf.Testing_Geared"
    xmlns:wpf="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    x:Name="root"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Real-time Line Chart  -->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="5"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="10,5"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Real-time Data" />

                <scottplot:WpfPlot
                    x:Name="LinePlot"
                    Grid.Row="1"
                    Margin="10" />
            </Grid>
        </Border>

        <!--  Bar Chart  -->
        <Border
            Grid.Row="0"
            Grid.Column="2"
            Margin="5"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="10,5"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Bar Chart" />

                <scottplot:WpfPlot
                    x:Name="BarPlot"
                    Grid.Row="1"
                    Margin="10" />
            </Grid>
        </Border>

        <!--  Scatter Plot  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="5"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="10,5"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Scatter Plot" />

                <Grid Grid.Row="1">
                    <scottplot:WpfPlot x:Name="ScatterPlot" Margin="10" />

                    <!--  Tooltip for scatter plot  -->
                    <Border
                        x:Name="ToolTipPanel"
                        Padding="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="Collapsed">
                        <Label x:Name="ToolTipLabel" Content="X: 0, Y: 0" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!--  Pie Chart  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="5"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="10,5"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Pie Chart" />

                <scottplot:WpfPlot
                    x:Name="PiePlot"
                    Grid.Row="1"
                    Margin="10" />
            </Grid>
        </Border>

        <!--  Histogram  -->
        <Border
            Grid.Row="1"
            Grid.Column="2"
            Margin="5"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="10,5"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Histogram" />

                <scottplot:WpfPlot
                    x:Name="HistogramPlot"
                    Grid.Row="1"
                    Margin="10" />
            </Grid>
        </Border>
    </Grid>
</Window>
