<Window
    x:Class="ProjectExporter.CreateVersionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    Title="Create New Version"
    Width="500"
    Height="350"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,20"
            Padding="15"
            Background="#E8F5E8"
            CornerRadius="4">
            <StackPanel>
                <TextBlock
                    FontSize="18"
                    FontWeight="Bold"
                    Text="📋 Create New Version" />
                <TextBlock
                    x:Name="BaseProjectText"
                    FontSize="12"
                    Foreground="Gray" />
            </StackPanel>
        </Border>

        <!--  Version Input  -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,15,0"
                VerticalAlignment="Center"
                FontWeight="Medium"
                Text="New Version:" />
            <TextBox
                x:Name="VersionTextBox"
                Grid.Column="1"
                Padding="10"
                mah:TextBoxHelper.AutoWatermark="True"
                mah:TextBoxHelper.Watermark="e.g., 1.1.0"
                FontSize="14" />
        </Grid>

        <!--  Description Input  -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,5"
                FontWeight="Medium"
                Text="Description:" />
            <TextBox
                x:Name="DescriptionTextBox"
                Grid.Row="1"
                Height="60"
                Padding="10"
                mah:TextBoxHelper.AutoWatermark="True"
                mah:TextBoxHelper.Watermark="Describe the changes in this version..."
                AcceptsReturn="True"
                FontSize="14"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>

        <!--  Preview  -->
        <GroupBox
            Grid.Row="3"
            Margin="0,0,0,20"
            Header="Preview">
            <StackPanel Margin="15">
                <TextBlock
                    x:Name="PreviewText"
                    FontStyle="Italic"
                    Foreground="Gray"
                    Text="New project will be created with the specified version and description."
                    TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <!--  Buttons  -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="CreateButton"
                Margin="5"
                Padding="20,10"
                Background="#4CAF50"
                BorderThickness="0"
                Click="CreateButton_Click"
                Content="✅ Create Version"
                Foreground="White"
                IsDefault="True" />
            <Button
                Margin="5"
                Padding="20,10"
                Click="CancelButton_Click"
                Content="❌ Cancel"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>