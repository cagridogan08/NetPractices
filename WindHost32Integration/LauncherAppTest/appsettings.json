{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
      "LogLevel": {
        "Default": "Information"
      }
    },
    "File": {
      "Path": "Logs/launcher-.log",
      "Append": true,
      "MinimumLevel": "Debug",
      "FileSizeLimitBytes": 10485760,
      "MaxRollingFiles": 10
    }
  },
  "LauncherConfiguration": {
    "HealthCheckInterval": "00:00:30",
    "MaxMemoryUsageMB": 150.0,
    "MaxResponseTime": "00:00:05",
    "EnableSystemTray": true,
    "EnableHealthChecks": true,
    "PipeName": "TESARunnerLauncher",
    "MaxConcurrentClients": 10,
    "ProcessMonitoring": {
      "EnableProcessTracking": true,
      "CleanupInterval": "00:05:00",
      "MaxProcessAge": "24:00:00"
    },
    "UI": {
      "RefreshInterval": "00:00:05",
      "ShowNotifications": true,
      "MinimizeToTray": true,
      "StartMinimized": false
    },
    "Security": {
      "AllowedExecutableExtensions": [
        ".exe",
        ".bat",
        ".cmd",
        ".ps1"
      ],
      "BlockedPaths": [
        "C:\\Windows\\System32",
        "C:\\Windows\\SysWOW64"
      ],
      "RequireDigitalSignature": false
    }
  },
  "Features": {
    "EnableAdvancedLogging": true,
    "EnablePerformanceCounters": true,
    "EnableCrashReporting": false,
    "EnableAutoUpdates": false,
    "EnableRemoteManagement": false
  },
  "Paths": {
    "LogDirectory": "%LOCALAPPDATA%\\TESA\\Logs",
    "ConfigDirectory": "%LOCALAPPDATA%\\TESA\\Config",
    "TempDirectory": "%TEMP%\\TESA",
    "DefaultRunnerPath": "",
    "DefaultProjectPath": ""
  },
  "Timeouts": {
    "ProcessStartTimeout": "00:00:30",
    "ProcessStopTimeout": "00:00:10",
    "NamedPipeConnectionTimeout": "00:00:05",
    "HealthCheckTimeout": "00:00:10"
  },
  "Resources": {
    "MaxConcurrentProcesses": 50,
    "MaxLogFileSizeMB": 10,
    "MaxLogFiles": 10,
    "MemoryWarningThresholdMB": 100,
    "MemoryCriticalThresholdMB": 200
  },
  "Notifications": {
    "ShowStartupNotification": true,
    "ShowProcessStartedNotification": false,
    "ShowProcessExitedNotification": false,
    "ShowHealthWarnings": true,
    "ShowErrorNotifications": true,
    "NotificationTimeout": 5000
  },
  "Maintenance": {
    "EnableLogCleanup": true,
    "LogRetentionDays": 30,
    "EnableTempFileCleanup": true,
    "TempFileRetentionDays": 7,
    "EnableCacheCleanup": true,
    "CacheRetentionDays": 14
  }
}