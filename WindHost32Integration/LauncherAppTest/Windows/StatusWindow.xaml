<Window
    x:Class="TESA.Desktop.Launcher.Windows.StatusWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TESA Desktop Launcher - Status"
    Width="900"
    Height="650"
    MinWidth="800"
    MinHeight="600"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,10,2" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style
            x:Key="StatusHealthy"
            BasedOn="{StaticResource ValueStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="Green" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style
            x:Key="StatusError"
            BasedOn="{StaticResource ValueStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Main Content  -->
        <TabControl Grid.Row="0" Margin="10">

            <!--  General Status Tab  -->
            <TabItem Header="📊 General Status">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Left Column  -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <GroupBox Header="🚀 Application Status">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Status:" />
                                    <TextBlock
                                        x:Name="StatusTextBlock"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Process ID:" />
                                    <TextBlock
                                        x:Name="ProcessIdTextBlock"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Started:" />
                                    <TextBlock
                                        x:Name="StartTimeTextBlock"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Uptime:" />
                                    <TextBlock
                                        x:Name="UptimeTextBlock"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Version:" />
                                    <TextBlock
                                        x:Name="VersionTextBlock"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Memory Usage:" />
                                    <TextBlock
                                        x:Name="MemoryUsageTextBlock"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Total Requests:" />
                                    <TextBlock
                                        x:Name="RequestsTextBlock"
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Last Request:" />
                                    <TextBlock
                                        x:Name="LastRequestTextBlock"
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="📈 Request Statistics">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Requests/Hour:" />
                                    <TextBlock
                                        x:Name="RequestsPerHourTextBlock"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />
                                </Grid>
                            </GroupBox>
                        </StackPanel>

                        <!--  Right Column  -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <GroupBox Header="❤️ Health Status">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Health:" />
                                    <TextBlock
                                        x:Name="HealthStatusTextBlock"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Last Check:" />
                                    <TextBlock
                                        x:Name="LastHealthCheckTextBlock"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Issues:" />
                                    <TextBlock
                                        x:Name="HealthIssuesTextBlock"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        x:Name="HealthErrorTextBlock"
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        FontStyle="Italic"
                                        Foreground="Red"
                                        Text=""
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="🔗 Named Pipe Server">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Pipe Name:" />
                                    <TextBlock
                                        x:Name="PipeNameTextBlock"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Status:" />
                                    <TextBlock
                                        x:Name="PipeStatusTextBlock"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Active Clients:" />
                                    <TextBlock
                                        x:Name="ActiveClientsTextBlock"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!--  Running Processes Tab  -->
            <TabItem Header="⚙️ Running Processes">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="Currently Running Processes" />

                    <GroupBox Grid.Row="1" Header="Process List">
                        <ListBox
                            x:Name="ProcessListBox"
                            FontFamily="Consolas"
                            FontSize="11"
                            SelectionMode="Single">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Margin" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3390FF" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </GroupBox>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="StopProcessButton"
                            Click="StopProcessButton_Click"
                            Content="🛑 Stop Selected Process" />
                        <Button
                            x:Name="RefreshProcessButton"
                            Click="RefreshButton_Click"
                            Content="🔄 Refresh List" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!--  System Information Tab  -->
            <TabItem Header="💻 System Information">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Left Column  -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <GroupBox Header="🖥️ System Information">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Operating System:" />
                                    <TextBlock
                                        x:Name="OSTextBlock"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Processor Count:" />
                                    <TextBlock
                                        x:Name="ProcessorCountTextBlock"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Machine Name:" />
                                    <TextBlock
                                        x:Name="MachineNameTextBlock"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="User:" />
                                    <TextBlock
                                        x:Name="UserNameTextBlock"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="CLR Version:" />
                                    <TextBlock
                                        x:Name="CLRVersionTextBlock"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Architecture:" />
                                    <TextBlock
                                        x:Name="ArchitectureTextBlock"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />
                                </Grid>
                            </GroupBox>
                        </StackPanel>

                        <!--  Right Column  -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <GroupBox Header="📊 Performance Counters">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Working Set:" />
                                    <TextBlock
                                        x:Name="WorkingSetTextBlock"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Virtual Memory:" />
                                    <TextBlock
                                        x:Name="VirtualMemoryTextBlock"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Private Memory:" />
                                    <TextBlock
                                        x:Name="PrivateMemoryTextBlock"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Handle Count:" />
                                    <TextBlock
                                        x:Name="HandleCountTextBlock"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Thread Count:" />
                                    <TextBlock
                                        x:Name="ThreadCountTextBlock"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Processor Time:" />
                                    <TextBlock
                                        x:Name="ProcessorTimeTextBlock"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueStyle}"
                                        Text="Loading..." />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!--  Button Panel  -->
        <Border
            Grid.Row="1"
            Background="#F5F5F5"
            BorderBrush="#CCCCCC"
            BorderThickness="0,1,0,0">
            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="TestConnectionButton"
                    Click="TestConnectionButton_Click"
                    Content="🔗 Test Connection" />
                <Button
                    x:Name="ViewLogsButton"
                    Click="ViewLogsButton_Click"
                    Content="📄 View Logs" />
                <Button
                    x:Name="OpenLogDirectoryButton"
                    Click="OpenLogDirectoryButton_Click"
                    Content="📁 Open Log Directory" />
                <Button
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    Content="🔄 Refresh All" />
                <Button
                    x:Name="CloseButton"
                    Click="CloseButton_Click"
                    Content="❌ Close"
                    IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>