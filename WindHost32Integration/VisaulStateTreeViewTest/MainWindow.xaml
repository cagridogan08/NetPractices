<Window
    x:Class="VisaulStateTreeViewTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:VisualStateEditor.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VisaulStateTreeViewTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  Converters  -->
        <converters:PropertyPathConverter x:Key="PropertyPathConverter" />
        <converters:KeyFrameValueConverter x:Key="KeyFrameValueConverter" />
        <converters:ObjectTypeConverter x:Key="ObjectTypeConverter" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <!--  Brushes  -->
        <SolidColorBrush x:Key="GroupBrush" Color="#FFBBDEFB" />
        <SolidColorBrush x:Key="StateBrush" Color="#FFE3F2FD" />
        <SolidColorBrush x:Key="TimelineBrush" Color="#FFECEFF1" />
        <SolidColorBrush x:Key="KeyFrameBrush" Color="#FFF5F5F5" />

        <!--  Template for KeyFrames  -->
        <DataTemplate x:Key="KeyFrameTemplate">
            <Border
                Margin="2"
                Padding="3"
                Background="{StaticResource KeyFrameBrush}"
                CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        FontWeight="Bold"
                        Text="Time:" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="{Binding KeyTime}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        FontWeight="Bold"
                        Text="Value:" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding Value, Converter={StaticResource KeyFrameValueConverter}}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Template for Timeline objects/Storyboard Children  -->
        <HierarchicalDataTemplate
            x:Key="TimelineTemplate"
            ItemTemplate="{StaticResource KeyFrameTemplate}"
            ItemsSource="{Binding KeyFrames}">
            <Border
                Margin="2"
                Padding="5"
                Background="{StaticResource TimelineBrush}"
                CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        FontWeight="Bold"
                        Text="{Binding ., Converter={StaticResource ObjectTypeConverter}}" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,3,0,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            FontWeight="SemiBold"
                            Text="Target:" />
                        <TextBlock Text="{Binding Target.Name, FallbackValue='Unknown'}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            FontWeight="SemiBold"
                            Text="Property:" />
                        <TextBlock Text="{Binding TargetProperty, Converter={StaticResource PropertyPathConverter}}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>

        <!--  Template for VisualStates  -->
        <HierarchicalDataTemplate
            x:Key="VisualStateTemplate"
            ItemTemplate="{StaticResource TimelineTemplate}"
            ItemsSource="{Binding Storyboard.Children}">
            <Border
                Margin="3"
                Padding="5"
                Background="{StaticResource StateBrush}"
                CornerRadius="4">
                <StackPanel>
                    <TextBlock
                        FontSize="13"
                        FontWeight="Bold"
                        Text="{Binding Name}" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Text="Storyboard Animations:"
                        Visibility="{Binding Storyboard.Children.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>

        <!--  Root Template for VisualStateGroups  -->
        <HierarchicalDataTemplate
            x:Key="VisualStateGroupTemplate"
            ItemTemplate="{StaticResource VisualStateTemplate}"
            ItemsSource="{Binding States}">
            <Border
                Margin="3"
                Padding="8"
                Background="{StaticResource GroupBrush}"
                CornerRadius="5">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="{Binding Name}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontStyle="Italic"
                        Text="{Binding States.Count, StringFormat='States: {0}'}" />
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header Section  -->
        <Border
            Grid.Row="0"
            Padding="15"
            Background="#2196F3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Visual State Explorer" />
                    <TextBlock
                        Foreground="White"
                        Opacity="0.85"
                        Text="View and edit visual states, storyboards, and animations" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Margin="5,0"
                        Padding="10,5"
                        Content="Load Control" />
                    <Button
                        Margin="5,0"
                        Padding="10,5"
                        Content="Save Changes" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Main Content Area  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Tree View Panel  -->
            <DockPanel Grid.Column="0" Background="#F5F5F5">
                <TextBlock
                    Margin="10"
                    Padding="5"
                    Background="#E0E0E0"
                    DockPanel.Dock="Top"
                    FontWeight="SemiBold"
                    Text="Visual State Hierarchy" />

                <TreeView
                    x:Name="VisualStateTreeView"
                    Margin="5"
                    ItemTemplate="{StaticResource VisualStateGroupTemplate}"
                    ItemsSource="{Binding VisualStateGroups}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                            <Setter Property="Padding" Value="3" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>

            <!--  Details Panel  -->
            <DockPanel Grid.Column="1" Background="White">
                <Border
                    Padding="10"
                    Background="#E0E0E0"
                    DockPanel.Dock="Top">
                    <TextBlock FontWeight="SemiBold" Text="Selected Item Details" />
                </Border>

                <ScrollViewer>
                    <ContentControl Margin="15" Content="{Binding ElementName=VisualStateTreeView, Path=SelectedItem}" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
