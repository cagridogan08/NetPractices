<Window
    x:Class="BinaryReaderWriter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,5"
            FontWeight="Bold"
            Text="Current File:" />
        <TextBox
            x:Name="txtFilePath"
            Grid.Row="1"
            Margin="0,0,0,10"
            IsReadOnly="True" />

        <TextBox
            x:Name="txtJsonContent"
            Grid.Row="2"
            Padding="5"
            AcceptsReturn="True"
            FontFamily="Consolas"
            FontSize="12"
            HorizontalScrollBarVisibility="Auto"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <StackPanel
            Grid.Row="3"
            Margin="0,10,0,0"
            Orientation="Horizontal">
            <Button
                x:Name="BtnOpen"
                Width="80"
                Margin="0,0,10,0"
                Click="BtnOpen_Click"
                Content="Open" />
            <Button
                x:Name="BtnSave"
                Width="80"
                Margin="0,0,10,0"
                Click="BtnSave_Click"
                Content="Save" />
            <Button
                x:Name="BtnValidate"
                Width="80"
                Margin="0,0,10,0"
                Click="BtnValidate_Click"
                Content="Validate" />
            <Button
                x:Name="BtnSampleJson"
                Width="100"
                Margin="0,0,10,0"
                Click="BtnSampleJson_Click"
                Content="Sample JSON" />
            <Button
                x:Name="BtnClear"
                Width="80"
                Margin="0,0,10,0"
                Click="BtnClear_Click"
                Content="Clear" />
        </StackPanel>
    </Grid>
</Window>
